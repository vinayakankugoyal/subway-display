// Machine-local settings: WiFi plus wherever your arrivals server lives.
// Copy to secrets.h and fill in. secrets.h is gitignored and must stay that way.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID      "your-network-name"
#define WIFI_PASSWORD  "your-network-password"

// The arrivals server on your LAN. Give that host a DHCP reservation, or this
// needs a reflash whenever its address moves.
#define ARRIVALS_URL   "http://SERVER-IP:8080/api/arrivals"

#endif /* SECRETS_H */
